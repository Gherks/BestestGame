@page "/Error"
@using System.Diagnostics

<PageTitle>Error | BestestGame</PageTitle>

<section class="surface recovery-page stack">
    <header class="page-heading"><h1>Unable to complete your request</h1><p>An unexpected error occurred. Return home and try again.</p></header>
    <p class="status status--error" role="alert">The requested page could not be loaded.</p>
    @if (ShowRequestId)
    {
        <div class="surface surface--well stack">
            <h2>Request ID</h2>
            <code>@RequestId</code>
            <p class="helper-text">Include this ID when reporting the problem.</p>
        </div>
    }
    <div><a href="/" class="button button--primary"><span class="button__content">Return home</span></a></div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

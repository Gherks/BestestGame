@page "/tournaments"
@rendermode InteractiveServer
@using BestestGame.Models
@using BestestGame.Services
@inject GameService GameService

<PageTitle>Tournaments | BestestGame</PageTitle>

<div class="tournaments-page stack">
    <header class="page-heading">
        <h1>Tournaments</h1>
        <p>Create a tournament for your game list. Select a tournament to manage its games and continue voting.</p>
    </header>

    <section class="surface stack" aria-labelledby="create-heading">
        <h2 id="create-heading">Create a tournament</h2>
        <form class="create-form" @onsubmit="CreateTournament" @onsubmit:preventDefault="true">
            <div class="field">
                <label class="field-label" for="tournament-name">Tournament name</label>
                <input id="tournament-name" type="text" class="form-control"
                       placeholder="e.g. Favourite games of 2026"
                       aria-describedby="tournament-name-help"
                       @bind="_newTournamentName" @bind:event="oninput" />
                <p id="tournament-name-help" class="helper-text">Each tournament has its own games and rankings.</p>
            </div>
            <button type="submit" class="tactile tactile--standard tactile--primary"
                    disabled="@string.IsNullOrWhiteSpace(_newTournamentName)">
                <span class="tactile__face">Create tournament</span>
            </button>
        </form>
        @if (!string.IsNullOrEmpty(_createMessage))
        {
            <p class="status status--success" role="status">@_createMessage</p>
        }
    </section>

    <section class="stack" aria-labelledby="tournament-list-heading">
        <h2 id="tournament-list-heading">Your tournaments</h2>
        @if (_tournaments.Count == 0)
        {
            <div class="surface empty-state">
                <h3>No tournaments yet</h3>
                <p>Create your first tournament above, then add the games you want to compare.</p>
            </div>
        }
        else
        {
            <ul class="tournament-list stack">
                @foreach (var tournament in _tournaments)
                {
                    var isActive = tournament.Id == _currentTournamentId;
                    var gameCount = tournament.Games.Count;
                    var duelCount = tournament.Duels.Count;
                    var completedCount = tournament.Duels.Count(d => d.IsCompleted);

                    <li @key="tournament.Id" class="surface tournament-row @(isActive ? "tournament-row--active" : "")">
                        <div class="tournament-details stack">
                            <div class="cluster">
                                <h3>@tournament.Name</h3>
                                @if (isActive)
                                {
                                    <span class="active-marker">Active</span>
                                }
                            </div>
                            <p class="tournament-summary text-secondary">
                                <span>@gameCount @(gameCount == 1 ? "game" : "games")</span>
                                <span>@completedCount of @duelCount matchups completed</span>
                            </p>
                        </div>
                        <div class="tournament-actions cluster">
                            <button type="button" class="tactile tactile--compact tactile--secondary"
                                    aria-label="@($"Select tournament: {tournament.Name}")"
                                    aria-pressed="@(isActive ? "true" : "false")"
                                    @onclick="() => SelectTournament(tournament.Id)">
                                <span class="tactile__face">@(isActive ? "Selected" : "Select tournament")</span>
                            </button>
                            @if (isActive)
                            {
                                <a href="/import" class="tactile tactile--compact tactile--secondary">
                                    <span class="tactile__face">Import games</span>
                                </a>
                                <a href="/vote" class="tactile tactile--compact tactile--primary">
                                    <span class="tactile__face">Vote</span>
                                </a>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private List<Tournament> _tournaments = new();
    private Guid? _currentTournamentId;
    private string _newTournamentName = string.Empty;
    private string _createMessage = string.Empty;

    protected override void OnInitialized()
    {
        LoadTournaments();
    }

    private void LoadTournaments()
    {
        _tournaments = GameService.GetTournaments();
        _currentTournamentId = GameService.GetCurrentTournament()?.Id;
    }

    private void CreateTournament()
    {
        if (string.IsNullOrWhiteSpace(_newTournamentName))
            return;

        var tournament = GameService.CreateTournament(_newTournamentName);
        _createMessage = $"Tournament \"{tournament.Name}\" created. It is now the active tournament.";
        _newTournamentName = string.Empty;
        LoadTournaments();
    }

    private void SelectTournament(Guid tournamentId)
    {
        GameService.SelectTournament(tournamentId);
        _createMessage = string.Empty;
        LoadTournaments();
    }
}

@page "/tournaments"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@using BestestGame.Models
@using BestestGame.Services
@inject GameService GameService
@inject TournamentSelectionNotifications SelectionNotifications

<PageTitle>Tournaments | BestestGame</PageTitle>

<div class="tournaments-page stack">
    <header class="page-heading">
        <h1>Tournaments</h1>
        <p>@(_tournaments.Count == 0 ? "Start your first game list, then add the games you want to compare." : "Choose a tournament to continue, or start a new game list.")</p>
        @if (_tournaments.Count > 0)
        {
            <div class="tournaments-create-link"><a href="/tournaments#create-heading" data-enhance-nav="false" class="button"><span class="button__content">Create a tournament</span></a></div>
        }
    </header>

    @if (!string.IsNullOrEmpty(_createMessage))
    {
        <section class="creation-next-step stack" aria-label="Next step for your new tournament">
            <p class="status status--success" role="status">@_createMessage</p>
            <div><a @ref="_createdAction" href="/import" class="button button--primary" data-created-next><span class="button__content">Add games</span></a></div>
        </section>
    }

    @if (!string.IsNullOrEmpty(_notice))
    {
        <p class="status status--success" role="status">@_notice</p>
    }

    @if (_tournaments.Count > 0)
    {
        <section class="stack" aria-labelledby="tournament-list-heading">
            <h2 id="tournament-list-heading" @ref="_listHeading" tabindex="-1">Your tournaments</h2>
            <ul class="tournament-list stack">
                @foreach (var tournament in _tournaments.OrderByDescending(t => t.Id == _currentTournamentId).ThenBy(t => t.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var isActive = tournament.Id == _currentTournamentId;
                    var gameCount = tournament.Games.Count;
                    var completedCount = tournament.Duels.Count(d => d.IsCompleted);
                    var nextTask = TournamentOverview.GetNextTask(tournament, true);
                    <li @key="tournament.Id" data-tournament-id="@tournament.Id" class="surface tournament-row @(isActive ? "tournament-row--active" : "")">
                        <div class="tournament-details stack">
                            <div class="cluster">
                                <h3>@tournament.Name</h3>
                                @if (isActive) { <span class="active-marker">Active</span> }
                            </div>
                            <p class="tournament-summary text-secondary">
                                <span>@gameCount @(gameCount == 1 ? "entry" : "entries")</span>
                                @if (gameCount < 2)
                                {
                                    <span>@(gameCount == 0 ? "Add games to begin" : "Add another entry to begin")</span>
                                }
                                else
                                {
                                    <span>@completedCount of @tournament.Duels.Count matchups finished</span>
                                }
                            </p>
                        </div>
                        <div class="tournament-actions cluster">
                            <button type="button" class="button" aria-label="@($"Select tournament: {tournament.Name}")" aria-pressed="@(isActive ? "true" : "false")" @onclick="() => SelectTournament(tournament.Id)"><span class="button__content">@(isActive ? "Selected" : "Select tournament")</span></button>
                            @if (isActive && string.IsNullOrEmpty(_createMessage))
                            {
                                <a @ref="_selectedAction" href="@nextTask.Href" class="button button--primary" data-selected-next><span class="button__content">@nextTask.Label</span></a>
                            }
                            <button type="button" class="button" aria-haspopup="dialog" aria-label="@($"Rename tournament: {tournament.Name}")" @onclick="() => PromptRename(tournament)"><span class="button__content">Rename</span></button>
                            <button type="button" class="button button--danger" aria-haspopup="dialog" aria-label="@($"Delete tournament: {tournament.Name}")" @onclick="() => _pendingDeletion = tournament"><span class="button__content">Delete</span></button>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="surface stack" aria-labelledby="create-heading">
        <h2 id="create-heading" tabindex="-1">Create a tournament</h2>
        <form class="create-form" @onsubmit="CreateTournament" @onsubmit:preventDefault="true">
            <div class="field">
                <label class="field-label" for="tournament-name">Tournament name</label>
                <input id="tournament-name" type="text" class="form-control" placeholder="e.g. Favourite games of 2026"
                       aria-describedby="tournament-name-help" @bind="_newTournamentName" @bind:event="oninput" />
                <p id="tournament-name-help" class="helper-text">Each tournament has its own games and matchups.</p>
            </div>
            <button type="submit" class="button @(_tournaments.Count == 0 ? "button--primary" : "")" disabled="@string.IsNullOrWhiteSpace(_newTournamentName)"><span class="button__content">Create tournament</span></button>
        </form>
    </section>

    <dialog @ref="_renameDialog" class="dialog tournament-dialog" aria-labelledby="rename-heading" aria-modal="true">
        @if (_pendingRename is not null)
        {
            <div class="dialog__header"><h2 id="rename-heading">Rename tournament</h2></div>
            <form class="stack" @onsubmit="ConfirmRename" @onsubmit:preventDefault="true">
                <div class="field">
                    <label class="field-label" for="tournament-rename">Tournament name</label>
                    <input id="tournament-rename" type="text" class="form-control" aria-describedby="tournament-rename-help" @bind="_renameText" @bind:event="oninput" />
                    <p id="tournament-rename-help" class="helper-text">Its games and results stay as they are.</p>
                </div>
                <div class="dialog__actions">
                    <button type="button" class="button" @onclick="CancelRename"><span class="button__content">Cancel</span></button>
                    <button type="submit" class="button button--primary" disabled="@string.IsNullOrWhiteSpace(_renameText)"><span class="button__content">Rename</span></button>
                </div>
            </form>
        }
    </dialog>

    <dialog @ref="_deleteDialog" class="dialog tournament-dialog" aria-labelledby="delete-heading" aria-describedby="delete-description" aria-modal="true">
        @if (_pendingDeletion is { } doomed)
        {
            var results = doomed.Duels.Count(duel => duel.IsCompleted);
            <div class="dialog__header"><h2 id="delete-heading">Delete tournament?</h2></div>
            <div id="delete-description" class="stack">
                <p>Delete <strong>@doomed.Name</strong>?</p>
                <p class="text-secondary">This permanently deletes its @Counted(doomed.Games.Count, "entry", "entries"), @Counted(results, "saved result", "saved results") and cover pictures. It cannot be undone.</p>
            </div>
            <div class="dialog__actions">
                <button type="button" autofocus class="button" @onclick="CancelDeletion"><span class="button__content">Cancel</span></button>
                <button type="button" class="button button--danger" @onclick="ConfirmDeletion"><span class="button__content">Delete tournament</span></button>
            </div>
        }
    </dialog>
</div>

@code {
    private List<Tournament> _tournaments = [];
    private Guid? _currentTournamentId;
    private string _newTournamentName = string.Empty;
    private string _createMessage = string.Empty;
    private ElementReference _createdAction;
    private ElementReference _selectedAction;
    private bool _focusCreatedAction;
    private bool _focusSelectedAction;
    private string _notice = string.Empty;
    private Tournament? _pendingRename;
    private string _renameText = string.Empty;
    private Tournament? _pendingDeletion;
    private ElementReference _renameDialog;
    private ElementReference _deleteDialog;
    private ElementReference _listHeading;
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<Tournaments>? _dialogReference;
    private static string Counted(int count, string one, string many) => $"{count} {(count == 1 ? one : many)}";

    protected override void OnInitialized() => LoadTournaments();

    private void LoadTournaments()
    {
        _tournaments = GameService.GetTournaments();
        _currentTournamentId = GameService.GetCurrentTournament()?.Id;
    }

    private void CreateTournament()
    {
        if (string.IsNullOrWhiteSpace(_newTournamentName)) return;
        var tournament = GameService.CreateTournament(_newTournamentName);
        _createMessage = $"Tournament \"{tournament.Name}\" created. It is now the active tournament.";
        _notice = string.Empty;
        _newTournamentName = string.Empty;
        LoadTournaments();
        SelectionNotifications.NotifyChanged();
        _focusCreatedAction = true;
        _focusSelectedAction = false;
    }

    private void SelectTournament(Guid tournamentId)
    {
        GameService.SelectTournament(tournamentId);
        _createMessage = _notice = string.Empty;
        LoadTournaments();
        SelectionNotifications.NotifyChanged();
        _focusCreatedAction = false;
        _focusSelectedAction = _currentTournamentId is not null;
    }

    private void PromptRename(Tournament tournament)
    {
        _pendingRename = tournament;
        _renameText = tournament.Name;
    }

    private void CancelRename() => _pendingRename = null;

    private void ConfirmRename()
    {
        if (_pendingRename is not { } tournament || string.IsNullOrWhiteSpace(_renameText)) return;
        _pendingRename = null;
        _createMessage = string.Empty;
        _notice = GameService.RenameTournament(tournament.Id, _renameText)
            ? $"Renamed \"{tournament.Name}\" to \"{_renameText.Trim()}\"."
            : "That tournament no longer exists.";
        LoadTournaments();
        SelectionNotifications.NotifyChanged();
    }

    private void CancelDeletion() => _pendingDeletion = null;

    private void ConfirmDeletion()
    {
        if (_pendingDeletion is not { } tournament) return;
        _pendingDeletion = null;
        _createMessage = string.Empty;
        var wasActive = tournament.Id == _currentTournamentId;
        _notice = !GameService.DeleteTournament(tournament.Id) ? "That tournament no longer exists."
            : $"Deleted \"{tournament.Name}\".{(wasActive ? " No tournament is active now." : "")}";
        LoadTournaments();
        SelectionNotifications.NotifyChanged();
    }

    [JSInvokable]
    public void CancelRenameFromKeyboard()
    {
        CancelRename();
        StateHasChanged();
    }

    [JSInvokable]
    public void CancelDeletionFromKeyboard()
    {
        CancelDeletion();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dialogModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/importDialog.js");
            _dialogReference = DotNetObjectReference.Create(this);
            await _dialogModule.InvokeVoidAsync("initialize", _renameDialog, _dialogReference, "CancelRenameFromKeyboard");
            await _dialogModule.InvokeVoidAsync("initialize", _deleteDialog, _dialogReference, "CancelDeletionFromKeyboard");
        }
        if (_dialogModule is not null)
        {
            // A deleted row cannot take focus back, so it returns to the list heading.
            await _dialogModule.InvokeVoidAsync("sync", _renameDialog, _pendingRename is not null, _listHeading, "tournament-rename");
            await _dialogModule.InvokeVoidAsync("sync", _deleteDialog, _pendingDeletion is not null, _listHeading);
        }
        if (_focusCreatedAction)
        {
            _focusCreatedAction = false;
            await _createdAction.FocusAsync();
        }
        else if (_focusSelectedAction)
        {
            _focusSelectedAction = false;
            await _selectedAction.FocusAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dialogModule is not null)
        {
            try
            {
                await _dialogModule.InvokeVoidAsync("dispose", _renameDialog);
                await _dialogModule.InvokeVoidAsync("dispose", _deleteDialog);
                await _dialogModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _dialogReference?.Dispose();
    }
}

@page "/import"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using BestestGame.Models
@using BestestGame.Services
@inject GameService GameService
@inject IJSRuntime JS

<PageTitle>Import games | BestestGame</PageTitle>

<div class="import-page stack">
    <header class="page-heading">
        <h1>Import games</h1>
        @if (_currentTournament is not null)
        {
            <p>Manage games in <strong>@_currentTournament.Name</strong>. New entries generate matchups with the other games in this tournament.</p>
        }
    </header>

    @if (_currentTournament is null)
    {
        <section class="surface empty-state stack">
            <h2>Select a tournament first</h2>
            <p>Create or select a tournament before adding games.</p>
            <div><a href="/tournaments" class="tactile tactile--standard tactile--primary"><span class="tactile__face">Go to tournaments</span></a></div>
        </section>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="@GetAlertClasses()" role="status">@_message</p>
        }

        <section class="surface stack" aria-labelledby="entry-heading">
            <h2 id="entry-heading">@(_editingGameId is null ? "Add a game" : "Edit game details")</h2>
            <p id="entry-help" class="helper-text">Included titles share this entry's points and matchups. Release years are optional; leave them blank when unknown.</p>
            <EditForm Model="_entry" OnValidSubmit="SaveEntry" @key="_entry" class="stack">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-errors" />
                <div class="entry-fields">
                    <div class="field">
                        <label for="entryTitle" class="field-label">Title</label>
                        <InputText id="entryTitle" @bind-Value="_entry.Title" readonly="@(_editingGameId is not null)" class="form-control" aria-describedby="entry-help" />
                        @if (_editingGameId is not null)
                        {
                            <p class="helper-text">The entry title cannot be changed when editing details.</p>
                        }
                    </div>
                    <div class="field">
                        <label for="entryYear" class="field-label">Release year (optional)</label>
                        <InputNumber id="entryYear" @bind-Value="_entry.ReleaseYear" min="1" max="9999" step="1" DisplayName="Release year" class="form-control" />
                        <ValidationMessage For="() => _entry.ReleaseYear" />
                    </div>
                </div>
                <fieldset class="included-titles stack">
                    <legend>Included titles</legend>
                    @foreach (var included in _entry.IncludedTitles)
                    {
                        <div @key="included" class="included-row">
                            <label class="field"><span class="field-label">Included title</span>
                                <InputText @bind-Value="included.Title" class="form-control" />
                            </label>
                            <label class="field"><span class="field-label">Release year (optional)</span>
                                <InputNumber @bind-Value="included.ReleaseYear" min="1" max="9999" step="1" DisplayName="Included title release year" class="form-control" />
                            </label>
                            <button type="button" @onclick="() => _entry.IncludedTitles.Remove(included)" class="tactile tactile--compact tactile--secondary" aria-label="@($"Remove included title: {(string.IsNullOrWhiteSpace(included.Title) ? "untitled" : included.Title)}")">
                                <span class="tactile__face">Remove included title</span>
                            </button>
                        </div>
                    }
                    <div><button type="button" @onclick="() => _entry.IncludedTitles.Add(new IncludedTitle())" class="tactile tactile--compact tactile--secondary"><span class="tactile__face">Add included title</span></button></div>
                </fieldset>
                <div class="cluster">
                    <button type="submit" class="tactile tactile--standard tactile--primary"><span class="tactile__face">@(_editingGameId is null ? "Add game" : "Save details")</span></button>
                    @if (_editingGameId is not null)
                    {
                        <button type="button" @onclick="ResetEntryForm" class="tactile tactile--standard tactile--secondary"><span class="tactile__face">Cancel editing</span></button>
                    }
                </div>
            </EditForm>
        </section>

        <section class="surface stack" aria-labelledby="bulk-heading" aria-busy="@(_isImporting ? "true" : "false")">
            <h2 id="bulk-heading">Bulk import</h2>
            <p id="bulk-help" class="helper-text">Enter one title per line. Duplicate titles are skipped. Assign release years using the form above or Edit details after importing.</p>
            <div class="field">
                <label for="gameTitles" class="field-label">Game titles</label>
                <textarea id="gameTitles" class="form-control" placeholder="@_placeholder" aria-describedby="bulk-help" @bind="_inputText" readonly="@_isImporting"></textarea>
            </div>
            <div class="cluster">
                <button type="button" class="tactile tactile--standard tactile--primary" @onclick="ImportGames" disabled="@_isImporting"><span class="tactile__face">@(_isImporting ? "Importing…" : "Import games")</span></button>
                @if (_isImporting)
                {
                    <p class="loading-state" role="status"><span class="loading-indicator" aria-hidden="true"></span>Adding games and generating matchups…</p>
                }
            </div>
        </section>

        @if (_addedGames.Count > 0)
        {
            <section class="surface stack" aria-labelledby="new-entries-heading">
                <h2 id="new-entries-heading">New entries ready for voting</h2>
                <p class="helper-text">Finish the new matchups to give these entries a place in the rankings.</p>
                <div class="cluster">
                    @foreach (var added in _addedGames)
                    {
                        <a href="@($"/vote?focus={added.Id}")" class="tactile tactile--compact tactile--secondary"><span class="tactile__face">Finish matchups for @added.Title</span></a>
                    }
                </div>
            </section>
        }

        <section class="stack" aria-labelledby="manage-heading">
            <h2 id="manage-heading" @ref="_manageHeading" tabindex="-1">Manage games</h2>
            <p class="helper-text">Removing a game deletes the entry, its included titles, and every matchup involving it.</p>
            @if (_games.Count == 0)
            {
                <div class="surface empty-state"><p>No games in this tournament yet. Add a game or import a list above.</p></div>
            }
            else
            {
                <ul class="game-list stack">
                    @foreach (var game in _games)
                    {
                        <li @key="game.Id" class="surface game-row">
                            <div class="game-details">
                                <h3>@game.Title@(game.ReleaseYear is { } year ? $" ({year})" : "")</h3>
                                @if (game.IncludedTitles is { Count: > 0 })
                                {
                                    <ul class="included-summary text-secondary">
                                        @foreach (var title in game.IncludedTitles)
                                        {
                                            <li>@title.Title@(title.ReleaseYear is { } includedYear ? $" ({includedYear})" : "")</li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="cluster">
                                <a href="@($"/vote?focus={game.Id}")" class="tactile tactile--compact tactile--secondary"><span class="tactile__face">Finish matchups</span></a>
                                <button type="button" class="tactile tactile--compact tactile--secondary" @onclick="() => EditGameDetails(game)" aria-label="@($"Edit details for {game.Title}")"><span class="tactile__face">Edit details</span></button>
                                <button type="button" class="tactile tactile--compact tactile--danger" @onclick="() => PromptRemoveGame(game)" aria-label="@($"Remove {game.Title}")" aria-haspopup="dialog"><span class="tactile__face">Remove</span></button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <dialog @ref="_removalDialog" class="dialog removal-dialog" aria-labelledby="removal-heading" aria-describedby="removal-description" aria-modal="true">
            @if (_gamePendingRemoval is not null)
            {
                <div class="dialog__header"><h2 id="removal-heading">Remove game?</h2></div>
                <div id="removal-description" class="stack">
                    <p>Remove <strong>@_gamePendingRemoval.Title</strong> from this tournament?</p>
                    <p class="text-secondary">This also deletes its included titles and every generated matchup involving this entry.</p>
                </div>
                <div class="dialog__actions">
                    <button type="button" autofocus class="tactile tactile--standard tactile--secondary" @onclick="CancelRemoveGame"><span class="tactile__face">Cancel</span></button>
                    <button type="button" class="tactile tactile--standard tactile--danger" @onclick="ConfirmRemoveGame"><span class="tactile__face">Remove game</span></button>
                </div>
            }
        </dialog>
    }
</div>

@code {
    private const string _placeholder =
        "Enter game titles here...\n\n" +
        "e.g.:\n" +
        "The Witcher 3\n" +
        "Elden Ring\n" +
        "Untitled Goose Game";

    private Tournament? _currentTournament;
    private List<Game> _games = [];
    private List<Game> _addedGames = [];
    private Game? _gamePendingRemoval;
    private string _inputText = string.Empty;
    private Game _entry = new();
    private Guid? _editingGameId;
    private string _message = string.Empty;
    private string _alertClass = "alert-success";
    private bool _isImporting = false;

    protected override void OnInitialized()
    {
        _currentTournament = GameService.GetCurrentTournament();
        LoadGames();
    }

    private async Task ImportGames()
    {
        if (_isImporting) return;

        var titles = _inputText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .ToList();

        if (titles.Count == 0)
        {
            _alertClass = "alert-warning";
            _message = "Enter at least one game title, with one title per line.";
            return;
        }

        _isImporting = true;
        try
        {
            await Task.Yield();
            var existingIds = _games.Select(game => game.Id).ToHashSet();
            var addedCount = GameService.ImportGames(titles);
            LoadGames();
            _addedGames = _games.Where(game => !existingIds.Contains(game.Id)).ToList();
            _alertClass = "alert-success";
            _message = $"Added {addedCount} game(s). Skipped {titles.Count - addedCount} duplicate title(s).";
            _inputText = string.Empty;
        }
        finally
        {
            _isImporting = false;
        }
    }

    private void SaveEntry()
    {
        if (string.IsNullOrWhiteSpace(_entry.Title))
        {
            _alertClass = "alert-warning";
            _message = "Enter a game title.";
            return;
        }
        if (_entry.ReleaseYear is < 1 or > 9999 || _entry.IncludedTitles.Any(t => t.ReleaseYear is < 1 or > 9999))
        {
            _alertClass = "alert-warning";
            _message = "Release years must be between 1 and 9999, or left blank.";
            return;
        }
        if (_entry.IncludedTitles.Any(t => string.IsNullOrWhiteSpace(t.Title)))
        {
            _alertClass = "alert-warning";
            _message = "Enter a title for each included title, or remove its row.";
            return;
        }
        var adding = _editingGameId is null;
        var existingIds = _games.Select(game => game.Id).ToHashSet();
        var saved = _editingGameId is { } gameId
            ? GameService.UpdateGameDetails(gameId, _entry.ReleaseYear, _entry.IncludedTitles)
            : GameService.ImportGames(new[] { _entry }) > 0;

        _alertClass = saved ? "alert-success" : "alert-warning";
        _message = saved
            ? (_editingGameId is null ? "Added game and its included titles." : "Updated game details.")
            : "Could not save. If this title already exists, use its Edit details button below.";
        if (saved)
        {
            ResetEntryForm();
            LoadGames();
            if (adding)
                _addedGames = _games.Where(game => !existingIds.Contains(game.Id)).ToList();
        }
    }

    private void EditGameDetails(Game game)
    {
        _editingGameId = game.Id;
        _entry = new Game
        {
            Title = game.Title,
            ReleaseYear = game.ReleaseYear,
            IncludedTitles = (game.IncludedTitles ?? []).Select(t => new IncludedTitle { Title = t.Title, ReleaseYear = t.ReleaseYear }).ToList()
        };
    }

    private void ResetEntryForm()
    {
        _editingGameId = null;
        _entry = new Game();
    }

    private void PromptRemoveGame(Game game)
    {
        ArgumentNullException.ThrowIfNull(game);
        _gamePendingRemoval = game;
    }

    private void CancelRemoveGame()
    {
        _gamePendingRemoval = null;
    }

    private void ConfirmRemoveGame()
    {
        if (_gamePendingRemoval is null)
            return;

        var game = _gamePendingRemoval;
        _gamePendingRemoval = null;

        if (GameService.RemoveGame(game.Id))
        {
            _addedGames.RemoveAll(added => added.Id == game.Id);
            if (_editingGameId == game.Id)
                ResetEntryForm();
            LoadGames();
            _alertClass = "alert-success";
            _message = $"Removed {game.Title} and every match that included it.";
            return;
        }

        _alertClass = "alert-warning";
        _message = "Could not remove that game title. Please refresh and try again.";
    }

    private void LoadGames()
    {
        _games = GameService.GetGames()
            .OrderBy(g => g.Title)
            .ToList();
    }

    private string GetAlertClasses() => _alertClass == "alert-warning"
        ? "status status--warning"
        : "status status--success";

    private ElementReference _removalDialog;
    private ElementReference _manageHeading;
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<Import>? _dialogReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_currentTournament is null) return;
        if (firstRender)
        {
            _dialogModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/importDialog.js");
            _dialogReference = DotNetObjectReference.Create(this);
            await _dialogModule.InvokeVoidAsync("initialize", _removalDialog, _dialogReference);
        }
        if (_dialogModule is not null)
            await _dialogModule.InvokeVoidAsync("sync", _removalDialog, _gamePendingRemoval is not null, _manageHeading);
    }

    [JSInvokable]
    public void CancelRemovalFromKeyboard()
    {
        CancelRemoveGame();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_dialogModule is not null)
        {
            try
            {
                await _dialogModule.InvokeVoidAsync("dispose", _removalDialog);
                await _dialogModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _dialogReference?.Dispose();
    }
}

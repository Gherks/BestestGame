        _editingGameId = game.Id;
        _renaming = rename;
        _entry = new Game
        {
            Title = game.Title,
            ReleaseYear = game.ReleaseYear,
            IncludedTitles = (game.IncludedTitles ?? []).Select(t => new IncludedTitle { Title = t.Title, ReleaseYear = t.ReleaseYear, CoverImage = t.CoverImage }).ToList()
        };
        OpenEntry();
    }


    private RenderFragment VotingActions => @<div class="stack completion-actions">
        @if (_addedGames.Any(game => _pendingMatchups.GetValueOrDefault(game.Id) > 0))
        {
            <p class="helper-text">Ready to give these entries a place in the rankings?</p>
            <div class="cluster">
                @foreach (var added in _addedGames.Where(game => _pendingMatchups.GetValueOrDefault(game.Id) > 0))
                {
                    <a href="@($"/vote?focus={added.Id}")" class="button button--primary"><span class="button__content">Finish matchups for @EntryTitles.FormatTitleWithYear(added.Title, added.ReleaseYear)</span></a>
                }
            </div>
        }
        else
        {
            <p class="helper-text">No new matchups to finish. Add another entry to begin voting, or continue managing your collection.</p>
        }
    </div>;

    private void ClearSearch()
    {
        _searchText = string.Empty;
        _focusSearch = true;
    }

    private void ResetEntryForm()
    {
        _editingGameId = null;
        _renaming = false;
        _entry = new Game();
    }

    private void PromptRemoveGame(Game game)
    {
        ArgumentNullException.ThrowIfNull(game);
        _gamePendingRemoval = game;
    }

    private void CancelRemoveGame()
    {
        _gamePendingRemoval = null;
    }

    private void ConfirmRemoveGame()
    {
        if (_gamePendingRemoval is null)
            return;

        var game = _gamePendingRemoval;
        _gamePendingRemoval = null;
        _messageLocation = MessageLocation.Library;

        if (GameService.RemoveGame(game.Id))
        {
            _addedGames.RemoveAll(added => added.Id == game.Id);
            if (_editingGameId == game.Id)
                ResetEntryForm();
            LoadGames();
            _alertClass = "alert-success";
            _message = $"Removed {EntryTitles.FormatTitleWithYear(game.Title, game.ReleaseYear)} and every match that included it.";
            return;
        }

        _alertClass = "alert-warning";
        _message = "Could not remove that game title. Please refresh and try again.";
    }

    // Cover art: a run over every entry and included title without a picture, and a chooser for the ones that
    // need a person. A picture belongs to a single game or to one included title of a collection.
    private CancellationTokenSource? _coverRun;
    private int _coverDone;
    private int _coverTotal;
    private readonly Dictionary<(Guid Game, int? Title), IReadOnlyList<CoverArtService.Candidate>> _coverCandidates = [];
    private ElementReference _coverDialog;
    private Game? _coverGame;
    // The included title the chooser is on, counted from zero; none for a single game.
    private int? _coverTitle;
    private string _coverQuery = string.Empty;
    private IReadOnlyList<CoverArtService.Candidate>? _coverResults;
    private string _coverNotice = string.Empty;
    private string _coverSaved = string.Empty;
    private string? _coverBusy;

    // A shelf of covers: one for a single game, one for each included title of a collection. Each is a button
    // that opens the cover chooser on it; a collection's shelf marks the cover that stands for the collection.
    private RenderFragment CoverShelf(Game game)
    {
        var shelf = CoverArtService.Slots(game);
        var standsFor = shelf.FirstOrDefault(slot => slot.Title is not null && !string.IsNullOrEmpty(slot.File))?.Title;
        return @<ul class="title-shelf">
            @foreach (var slot in shelf)
            {
                var title = slot.Title is { } index ? game.IncludedTitles[index] : null;
                var picture = CoverArt.Url(slot.File);
                <li @key="slot.Title">
                    <button type="button" class="title-card" data-included-title="@slot.Title" aria-haspopup="dialog" @onclick="() => OpenCoverChooser(game, slot.Title)"
                            aria-label="@($"Choose cover for {SlotTitle(slot)}{(picture is null ? ", no cover yet" : standsFor is not null && slot.Title == standsFor ? ", the collection's cover" : "")}")">
                        @if (picture is not null)
                        {
                            <span class="title-card-cover" style="background-image: url('@picture')"></span>
                        }
                        else
                        {
                            <span class="title-card-cover title-card-cover--none"><span>No cover</span></span>
                        }
                        <span class="title-card-title">@(title?.Title ?? game.Title)</span>
                        @if ((title is null ? game.ReleaseYear : title.ReleaseYear) is { } released)
                        {
                            <span class="title-card-year">@released</span>
                        }
                        @if (standsFor is not null && slot.Title == standsFor)
                        {
                            <span class="title-card-mark">Collection cover</span>
                        }
                    </button>
                </li>
            }
        </ul>;
    }

    private static string SlotTitle(CoverArtService.Slot slot) => slot.Title is { } index
        ? EntryTitles.FormatTitleWithYear(slot.Game.IncludedTitles[index].Title, slot.Game.IncludedTitles[index].ReleaseYear)
        : EntryTitles.GetTitleDisplay(slot.Game).Title;

    private async Task FetchMissingCovers()
    {
        if (_coverRun is not null) return;
        var missing = _games.SelectMany(CoverArtService.Slots).Where(slot => !Covers.HasCoverFile(slot)).ToList();
        _messageLocation = MessageLocation.Library;
        _alertClass = "alert-success";
        if (missing.Count == 0)
        {
            _message = "Every entry and included title already has a cover.";
            return;
        }
        _message = string.Empty;
        (_coverDone, _coverTotal) = (0, missing.Count);
        int added = 0, undecided = 0, unknown = 0, absent = 0;
        string? problem = null;
        using var run = _coverRun = new CancellationTokenSource();
        try
        {
            foreach (var slot in missing)
            {
                var result = await Covers.FetchAsync(slot, run.Token);
                if (result.Outcome == CoverArtService.Outcome.Added) added++;
                else if (result.Outcome == CoverArtService.Outcome.NotFound) unknown++;
                else if (result.Outcome == CoverArtService.Outcome.UploadMissing) absent++;
                else
                {
                    undecided++;
                    _coverCandidates[(slot.Game.Id, slot.Title)] = result.Candidates;
                }
                _coverDone++;
                StateHasChanged();
            }
        }
        catch (CoverArtService.CoverArtException exception) { problem = exception.Message; }
        catch (OperationCanceledException) { problem = "Stopped before every entry was looked up."; }
        finally { _coverRun = null; }
        LoadGames();
        if (problem is not null) _alertClass = "alert-warning";
        _message = string.Join(" ", new[]
        {
            problem,
            $"Added {added} {(added == 1 ? "cover" : "covers")}.",
            undecided > 0 ? $"{undecided} had no certain match: choose from each entry's Actions." : null,
            unknown > 0 ? $"{unknown} could not be found: upload a picture from the entry's Actions." : null,
            absent > 0 ? $"{absent} uploaded {(absent == 1 ? "picture is" : "pictures are")} not in this covers folder." : null
        }.Where(part => part is not null));
    }

    // A collection opens on the title that was picked from its shelf, or else on the one that most needs a person:
    // one with candidates waiting, else one without a cover, else its first.
    private async Task OpenCoverChooser(Game game, int? title = null)
    {
        var slots = CoverArtService.Slots(game);
        _coverGame = game;
        _coverTitle = (slots.FirstOrDefault(slot => title is not null && slot.Title == title)
            ?? slots.FirstOrDefault(slot => slot.File is null && _coverCandidates.ContainsKey((game.Id, slot.Title)))
            ?? slots.FirstOrDefault(slot => slot.File is null) ?? slots[0]).Title;
        _coverSaved = string.Empty;
        await ShowCoverSlot();
    }

    private async Task ChangeCoverTitle(ChangeEventArgs change)
    {
        if (_coverGame is not { } game || _coverBusy is not null || !int.TryParse(change.Value?.ToString(), out var title) ||
            title < 0 || title >= game.IncludedTitles.Count) return;
        _coverTitle = title;
        _coverSaved = string.Empty;
        await ShowCoverSlot();
    }

    private async Task ShowCoverSlot()
    {
        if (_coverGame is not { } game) return;
        _coverQuery = CoverArtService.Subject(game, _coverTitle).Title;
        _coverNotice = string.Empty;
        _coverResults = _coverCandidates.GetValueOrDefault((game.Id, _coverTitle));
        if (_coverResults is null && Covers.IsConfigured) await SearchCovers();
    }

    private async Task SearchCovers()
    {
        if (_coverGame is null || _coverBusy is not null) return;
        _coverBusy = "Searching…";
        _coverNotice = string.Empty;
        try
        {
            _coverResults = await Covers.SearchAsync(_coverQuery);
            if (_coverResults.Count == 0) _coverNotice = "IGDB has no cover under that title. Try another spelling.";
        }
        catch (CoverArtService.CoverArtException exception) { _coverNotice = exception.Message; }
        finally { _coverBusy = null; }
    }

    private async Task ChooseCover(CoverArtService.Candidate candidate)
    {
        if (_coverGame is not { } game || _coverBusy is not null) return;
        _coverBusy = "Saving the cover…";
        try
        {
            await Covers.SetCoverAsync(game.Id, candidate.ImageId, _coverTitle);
        }
        catch (CoverArtService.CoverArtException exception)
        {
            _coverNotice = exception.Message;
            return;
        }
        finally { _coverBusy = null; }
        await CoverSaved();
    }

    private async Task UploadCover(InputFileChangeEventArgs upload)
    {
        if (_coverGame is not { } game || _coverBusy is not null) return;
        _coverBusy = "Saving the cover…";
        _coverNotice = string.Empty;
        try
        {
            // The browser never answers a request to shrink a file it cannot read as a picture, so the
            // file's first bytes are checked before asking, and the request is given a time limit.
            var start = new byte[12];
            await using (var original = upload.File.OpenReadStream(long.MaxValue))
                await original.ReadExactlyAsync(start.AsMemory(0, (int)Math.Min(start.Length, upload.File.Size)));
            if (!CoverArtService.LooksLikePicture(start))
                throw new CoverArtService.CoverArtException("That file is not a JPEG, PNG or WebP picture.");
            // Shrinking it there means a large photo neither travels here nor is served at full size on every vote.
            var shrunk = await upload.File.RequestImageFileAsync("image/jpeg", CoverArtService.UploadWidth, CoverArtService.UploadHeight)
                .AsTask().WaitAsync(TimeSpan.FromSeconds(20));
            await using var picture = shrunk.OpenReadStream(CoverArtService.UploadLimit);
            await Covers.SetUploadedCoverAsync(game.Id, picture, _coverTitle);
        }
        catch (Exception exception) when (exception is CoverArtService.CoverArtException or TimeoutException or IOException)
        {
            _coverNotice = exception switch
            {
                TimeoutException => "The browser could not read that file as a picture.",
                IOException => "The picture could not be read. Try again.",
                _ => exception.Message
            };
            return;
        }
        finally { _coverBusy = null; }
        await CoverSaved();
    }

    // A collection stays open on its next title without a cover, so all of them can be chosen in one go.
    private async Task CoverSaved()
    {
        if (_coverGame is not { } game) return;
        var saved = SlotTitle(new(game, _coverTitle));
        _coverCandidates.Remove((game.Id, _coverTitle));
        LoadGames();
        _messageLocation = _entryOpen ? MessageLocation.Entry : MessageLocation.Library;
        _alertClass = "alert-success";
        _message = $"Cover saved for {saved}.";
        if (_coverGame is { } current && _coverTitle is not null &&
            CoverArtService.Slots(current).FirstOrDefault(slot => string.IsNullOrEmpty(slot.File)) is { } next)
        {
            _coverTitle = next.Title;
            _coverSaved = $"Cover saved for {saved}. Next without one: {SlotTitle(next)}.";
            await ShowCoverSlot();
        }
        else CloseCoverChooser();
    }

    private void RemoveCover(CoverArtService.Slot slot)
    {
        Covers.ClearCover(slot.Game.Id, slot.Title);
        LoadGames();
        _messageLocation = _entryOpen ? MessageLocation.Entry : MessageLocation.Library;
        _alertClass = "alert-success";
        _message = $"Cover removed from {SlotTitle(slot)}.";
        CloseCoverChooser();
    }

    private void CloseCoverChooser()
    {
        _coverGame = null;
        _coverTitle = null;
        _coverResults = null;
        _coverSaved = string.Empty;
    }

    private void LoadGames()
    {
        _currentTournament = GameService.GetCurrentTournament();
        _games = (_currentTournament?.Games ?? [])
            .OrderBy(g => g.Title, StringComparer.OrdinalIgnoreCase)
            .ThenBy(g => g.Id)
            .ToList();
        _pendingMatchups = _currentTournament is null ? [] : GameLibrary.PendingMatchups(_currentTournament);
        _addedGames = _addedGames.Select(added => _games.FirstOrDefault(game => game.Id == added.Id)).OfType<Game>().ToList();
        // An open cover chooser follows the entry as it is now, and closes if the entry or its title has gone.
        if (_coverGame is { } shown)
        {
            _coverGame = _games.FirstOrDefault(game => game.Id == shown.Id);
            if (_coverGame is null || CoverArtService.Slots(_coverGame).All(slot => slot.Title != _coverTitle)) CloseCoverChooser();
        }
    }

    private string GetAlertClasses() => _alertClass == "alert-warning"
        ? "status status--warning"
        : "status status--success";

    private ElementReference _removalDialog;
    private ElementReference _manageHeading;
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<Import>? _dialogReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_currentTournament is null) return;
        if (firstRender)
        {
            _dialogModule = await JS.InvokeAsync<IJSObjectReference>("import", ScriptModules.Url("importDialog.js"));
            _dialogReference = DotNetObjectReference.Create(this);
            await _dialogModule.InvokeVoidAsync("initialize", _removalDialog, _dialogReference);
            await _dialogModule.InvokeVoidAsync("initialize", _entryDialog, _dialogReference, "CancelEntryFromKeyboard");
            await _dialogModule.InvokeVoidAsync("initialize", _importDialog, _dialogReference, "CancelImportFromKeyboard");
            await _dialogModule.InvokeVoidAsync("initialize", _coverDialog, _dialogReference, "CancelCoverFromKeyboard");
            _libraryModule = await JS.InvokeAsync<IJSObjectReference>("import", ScriptModules.Url("gameLibrary.js"));
            await _libraryModule.InvokeVoidAsync("initialize", _libraryRoot);
        }
        if (_dialogModule is not null)
        {
            await _dialogModule.InvokeVoidAsync("sync", _removalDialog, _gamePendingRemoval is not null, _manageHeading);
            await _dialogModule.InvokeVoidAsync("sync", _entryDialog, _entryOpen, _manageHeading, _editingGameId is null || _renaming ? "entryTitle" : "entryYear");
            await _dialogModule.InvokeVoidAsync("sync", _importDialog, _importOpen, _manageHeading, "gameTitles");
            await _dialogModule.InvokeVoidAsync("sync", _coverDialog, _coverGame is not null, _manageHeading, "coverQuery");
        }
        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchInput.FocusAsync();
        }
        if (_focusFeedback && !string.IsNullOrEmpty(_message))
        {
            _focusFeedback = false;
            if (_dialogModule is not null)
                await _dialogModule.InvokeVoidAsync("focusFeedback", _formFeedback);
        }
        if (_focusValidation && _dialogModule is not null)
        {
            _focusValidation = false;
            await _dialogModule.InvokeVoidAsync("focusFeedback", _validationFeedback);
        }
    }

    [JSInvokable]
    public void CancelEntryFromKeyboard()
    {
        CloseEntry();
        StateHasChanged();
    }

    [JSInvokable]
    public void CancelImportFromKeyboard()
    {
        CloseImport();
        StateHasChanged();
    }

    [JSInvokable]
    public void CancelCoverFromKeyboard()
    {
        CloseCoverChooser();
        StateHasChanged();
    }

    [JSInvokable]
    public void CancelRemovalFromKeyboard()
    {
        CancelRemoveGame();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _coverRun?.Cancel();
        if (_libraryModule is not null)
        {
            try
            {
                await _libraryModule.InvokeVoidAsync("dispose", _libraryRoot);
                await _libraryModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        if (_dialogModule is not null)
        {
            try
            {
                await _dialogModule.InvokeVoidAsync("dispose", _removalDialog);
                await _dialogModule.InvokeVoidAsync("dispose", _entryDialog);
                await _dialogModule.InvokeVoidAsync("dispose", _importDialog);
                await _dialogModule.InvokeVoidAsync("dispose", _coverDialog);
                await _dialogModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _dialogReference?.Dispose();
    }
}

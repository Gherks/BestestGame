@page "/"

<PageTitle>Home | BestestGame</PageTitle>

<div class="home-page stack">
    <section class="surface home-introduction stack" aria-labelledby="home-heading">
        <p class="eyebrow">Your game rankings</p>
        <div class="page-heading">
            <h1 id="home-heading">Find your favourite games.</h1>
            <p>Build a tournament from your game list, choose a winner in each matchup, and see your rankings take shape.</p>
        </div>
        <div class="cluster">
            <a href="/vote" class="tactile tactile--standard tactile--primary">
                <span class="tactile__face">Start voting</span>
            </a>
            <a href="/import" class="tactile tactile--standard tactile--secondary">
                <span class="tactile__face">Import games</span>
            </a>
        </div>
        <p class="text-secondary">Getting started? <a href="/tournaments" class="text-link">Create a tournament</a> before adding games.</p>
    </section>

    <section class="stack" aria-labelledby="getting-started-heading">
        <h2 id="getting-started-heading">How it works</h2>
        <ol class="getting-started">
            <li class="surface stack">
                <p class="eyebrow">Step 1</p>
                <h3>Create a tournament</h3>
                <p class="text-secondary">Give your list a name. Each tournament keeps its own games, matchups, and rankings.</p>
            </li>
            <li class="surface stack">
                <p class="eyebrow">Step 2</p>
                <h3>Add your games</h3>
                <p class="text-secondary">Add titles individually or import a list into your selected tournament.</p>
            </li>
            <li class="surface stack">
                <p class="eyebrow">Step 3</p>
                <h3>Choose your winners</h3>
                <p class="text-secondary">Compare two games at a time. Your choices build the tournament leaderboard.</p>
            </li>
        </ol>
    </section>
</div>

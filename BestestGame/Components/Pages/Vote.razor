@page "/vote"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PersistentComponentState PageState
@using BestestGame.Models
@using BestestGame.Services
@using static BestestGame.Components.EntryTitles
@inject GameService GameService
@inject NavigationManager Navigation

<PageTitle>Voting | BestestGame</PageTitle>

@if (_currentTournament is null)
{
    <section class="surface voting-arena stack">
        <header class="page-heading"><h1>Voting</h1><p>Select a tournament to compare its games.</p></header>
        <div class="empty-state stack">
            <h2>No tournament selected</h2>
            <p>Create or select a tournament before you start voting.</p>
            <div><a href="/tournaments" class="button button--primary"><span class="button__content">Go to tournaments</span></a></div>
        </div>
    </section>
}
else
{
    <section @ref="_root" class="surface voting-arena stack @(FocusEntry is null ? "ordinary-voting" : "")" aria-labelledby="voting-heading"
             data-shortcuts-enabled="@(_sessionReady && FocusEntry is null ? "true" : "false")"
             data-presentation="@_ordinary.Presentation">
        <header class="page-heading">
            <h1 id="voting-heading">Voting</h1>
            <p>@(FocusEntry is null ? "Choose the game you prefer." : $"Focused voting in {_currentTournament.Name}.")</p>
        </header>
        @if (FocusEntry is { } focusedId)
        {
            @if (_sessionReady)
            {
                <FocusedVoting @key="(_currentTournament.Id, focusedId)" TournamentId="_currentTournament.Id" GameId="focusedId"
                               BannedGameIds="_arenaBannedGameIds" RankingsUrl="@RankingsUrl" OnResultsChanged="RefreshVoting" />
            }
            else
            {
                <p class="loading-state" role="status">Loading voting settings…</p>
            }

        }
        else
        {
            var presentation = _ordinary.Presentation;
            @if (!_tournamentChanged)
            {
            <div class="voting-progress compact-progress">
                <div class="cluster text-secondary">
                    <span><strong class="count-settle" @key="_completedCount">@_completedCount</strong> of @_totalCount matchups complete</span>
                    <span>@_pendingCount remaining</span>
                </div>
                <progress class="progress-bar" value="@_completedCount" max="@Math.Max(1, _totalCount)" aria-label="Completed tournament matchups">@_completedCount of @_totalCount</progress>
                @if (_arenaBannedGameIds.Count > 0)
                {
                    <p class="helper-text">@_presentablePendingCount available with your voting exclusions.</p>
                }
            </div>
            }
            <div class="duel-stage" data-duel-stage data-duel-key="@_currentDuel?.Id">
            <div data-duel-content>
            @if (_tournamentChanged)
            {
                <div class="status status--warning stack" role="status">
                    <h2>Tournament changed</h2>
                    <p>Reload Voting to use the active tournament.</p>
                    <div><a href="@Navigation.Uri" data-enhance-nav="false" class="button button--primary"><span class="button__content">Reload Voting</span></a></div>
                </div>
            }
            else if (_games.Count < 2)
            {
                <div class="empty-state stack">
                    <h2>Add games to start voting</h2>
                    <p>A matchup needs at least two entries in this tournament.</p>
                    <div><a href="/import" class="button button--primary"><span class="button__content">Import games</span></a></div>
                </div>
            }
            else if (_currentDuel is null)
            {
                @if (_onlyArenaBanMatchesRemain)
                {
                    <div class="status status--warning stack">
                        <h2>Only arena-banned matchups remain</h2>
                        <p>Every remaining matchup includes an arena-banned entry. Uncheck a title on <a href="@RankingsUrl" class="text-link">Rankings</a> to resume voting.</p>
                    </div>
                }
                else
                {
                    <div class="status status--success stack">
                        <h2>All matchups complete</h2>
                        <p>Your results are ready.</p>
                        <div><a href="@RankingsUrl" class="button button--primary"><span class="button__content">View rankings</span></a></div>
                    </div>
                }
            }
            else if (_game1 is not null && _game2 is not null)
            {
                var duelId = _currentDuel.Id;
                var leftId = _game1.Id;
                var rightId = _game2.Id;
                var leftDisplay = GetTitleDisplay(_game1);
                var rightDisplay = GetTitleDisplay(_game2);
                <div class="matchup-grid">
                    <button type="button" class="tactile tactile--large tactile--secondary voting-choice" disabled="@(!_sessionReady)" data-choice="left" data-action="left" data-duel-id="@duelId" data-winner-id="@leftId"
                            aria-label="@($"Vote for {leftDisplay.Title}")" @onclick="() => CastVote(presentation, duelId, leftId)">
                        <span @key="(duelId, leftId)" class="tactile__face">
                            <span class="choice-title">@leftDisplay.Title</span>
                            @if (_game1.IncludedTitles is { Count: > 0 } included1)
                            {
                                <span class="choice-context">Collection · @included1.Count included @(included1.Count == 1 ? "title" : "titles")</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(leftDisplay.Subtitle))
                            {
                                <span class="choice-context">Collection</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(leftDisplay.Subtitle))
                            {
                                <span class="choice-subtitle">@leftDisplay.Subtitle</span>
                            }
                        </span>
                    </button>
                    <span class="matchup-versus" aria-hidden="true">vs</span>
                    <button type="button" class="tactile tactile--large tactile--secondary voting-choice" disabled="@(!_sessionReady)" data-choice="right" data-action="right" data-duel-id="@duelId" data-winner-id="@rightId"
                            aria-label="@($"Vote for {rightDisplay.Title}")" @onclick="() => CastVote(presentation, duelId, rightId)">
                        <span @key="(duelId, rightId)" class="tactile__face">
                            <span class="choice-title">@rightDisplay.Title</span>
                            @if (_game2.IncludedTitles is { Count: > 0 } included2)
                            {
                                <span class="choice-context">Collection · @included2.Count included @(included2.Count == 1 ? "title" : "titles")</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(rightDisplay.Subtitle))
                            {
                                <span class="choice-context">Collection</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(rightDisplay.Subtitle))
                            {
                                <span class="choice-subtitle">@rightDisplay.Subtitle</span>
                            }
                        </span>
                    </button>
                </div>
            }
            </div>
            </div>
            @if (!string.IsNullOrEmpty(_voteNotice))
            {
                <p class="vote-notice text-secondary" role="status">@_voteNotice</p>
            }
            <div class="cluster arena-actions">
                <button type="button" class="button" data-action="undo" disabled="@(!_ordinary.CanUndo || !_sessionReady)" @onclick="() => UndoLastVote(presentation)"><span class="button__content">Undo</span></button>
                <button type="button" class="button" data-action="skip" disabled="@(_currentDuel is null || !_sessionReady)" @onclick="() => SkipMatch(presentation)"><span class="button__content">Skip for now</span></button>
            </div>
        }
        @if (_games.Count > 0)
        {
            <details class="voting-options">
                <summary>Voting options · @(FocusEntry is not null ? $"Focused: {FocusedEntryTitle}" : "All matchups")</summary>
                <div class="stack options-content">
                <div class="focus-controls">
                <div class="field">
                    <label for="focusEntry" class="field-label">Focus on entry</label>
                    <select id="focusEntry" value="@FocusEntry" @onchange="ChangeFocusedEntry" class="form-control" disabled="@(!_sessionReady)">
                        <option value="">All matchups</option>
                        @* Entries with at most one matchup left are hidden, except the focused one so the selector matches the page.
                           The stable sort keeps tournament placement among equal remaining counts. *@
                        @foreach (var entry in TournamentStandings.Rank(_games).Select(standing => standing.Game)
                            .Where(game => _pendingPerGame.GetValueOrDefault(game.Id) > 1 || game.Id == FocusEntry)
                            .OrderByDescending(game => _pendingPerGame.GetValueOrDefault(game.Id)))
                        {
                            <option value="@entry.Id">@GetTitleDisplay(entry).Title · @_pendingPerGame.GetValueOrDefault(entry.Id) remaining</option>
                        }
                    </select>
                </div>
                <a href="/import" class="text-link">Add another entry</a>
                </div>
                @if (FocusEntry is null)
                {
                    <div class="field">
                        <label class="checkbox-field">
                            <input type="checkbox" checked="@_closestFirst" disabled="@(!_sessionReady)" @onchange="ToggleClosestFirst" />
                            Closest matchups first
                        </label>
                        <p class="helper-text">Asks about entries that are level on points before lopsided pairs. Applies from the next matchup.</p>
                    </div>
                }
                <div><a href="@RankingsUrl" class="text-link">View rankings and voting exclusions</a></div>
                @if (FocusEntry is null)
                {
                    <p class="helper-text">Shortcuts: 1 / Left chooses the first game; 2 / Right chooses the second. U undoes your last vote; S skips. Skip leaves the matchup pending.</p>
                }
                else
                {
                    <p class="helper-text">Votes save immediately. Turn off Adaptive groups for rapid 1v1. Shortcuts: 1 / Left chooses your entry; 2 / Right chooses all current opponents. M splits without saving; U undoes the last vote or queue change; S skips. The bar under the choices shows every opponent from highest to lowest ranked; select a segment to vote on that group next.</p>
                }
                </div>
            </details>
        }

    </section>

}

@code {
    [SupplyParameterFromQuery(Name = "year")]
    public int? LeaderboardYear { get; set; }
    [SupplyParameterFromQuery(Name = "focus")]
    public Guid? FocusEntry { get; set; }
    private string FocusUrl(Guid? gameId) => VotingRoutes.Focus(gameId, LeaderboardYear);
    private void ChangeFocusedEntry(ChangeEventArgs args)
        => Navigation.NavigateTo(FocusUrl(Guid.TryParse(args.Value?.ToString(), out var gameId) ? gameId : null));
    private string RankingsUrl => VotingRoutes.Rankings(LeaderboardYear);
    private string FocusedEntryTitle => _games.FirstOrDefault(game => game.Id == FocusEntry) is { } game
        ? GetTitleDisplay(game).Title : "Unavailable entry";
    private Tournament? _currentTournament;
    private readonly OrdinaryDuelSession _ordinary = new();
    private Duel? _currentDuel => _ordinary.Current;
    private ElementReference _root;
    private IJSObjectReference? _shortcutModule;
    private Game? _game1;
    private Game? _game2;
    private List<Game> _games = new();
    private Dictionary<Guid, int> _pendingPerGame = new();
    private int _pendingCount;
    private int _completedCount;
    private int _totalCount;
    private int _presentablePendingCount;
    private bool _onlyArenaBanMatchesRemain;
    private readonly ArenaExclusionSession _exclusions = new();
    private IReadOnlySet<Guid> _arenaBannedGameIds => _exclusions.GetIds(_currentTournament?.Id);
    private bool _restoreExclusions = true;
    private bool _restoringExclusions;
    private bool _tournamentChanged;
    private bool _sessionReady => !_tournamentChanged && !_restoreExclusions && _currentTournament is not null && _exclusions.IsReadyFor(_currentTournament.Id);
    private string _voteNotice = string.Empty;
    // An order preference for the browser tab, like the focused voting toggles.
    private const string ClosestFirstKey = "bestestgame:ordinary:closest-first";
    private bool _closestFirst = true;
    private const string InitialDuelStateKey = "Vote.InitialDuel";
    private PersistingComponentStateSubscription? _persistingSubscription;

    private record InitialDuelSelection(Guid TournamentId, Guid? DuelId);

    protected override void OnParametersSet()
    {
        if (VotingRoutes.LegacyDestination(LeaderboardYear, FocusEntry,
            Navigation.ToBaseRelativePath(Navigation.Uri)) is { } destination)
        {
            Navigation.NavigateTo(destination, replace: true);
            return;
        }
        var tournament = GameService.GetCurrentTournament();
        if (_currentTournament?.Id != tournament?.Id)
        {
            _currentTournament = tournament;
            _ordinary.Reset();
            _tournamentChanged = false;
            _voteNotice = string.Empty;
        }
        _restoreExclusions = _restoringExclusions ||
            (_currentTournament is not null && !_exclusions.IsReadyFor(_currentTournament.Id));
        LoadNextDuel(_currentDuel?.Id);
    }

    protected override void OnInitialized()
    {
        _currentTournament = GameService.GetCurrentTournament();
        if (_currentTournament is not null)
        {
            // Reuse the prerendered selection when the interactive component starts.
            // Revalidate it against pending duels in case another session voted.
            var initialDuelId = PageState.TryTakeFromJson<InitialDuelSelection>(InitialDuelStateKey, out var selection)
                && selection?.TournamentId == _currentTournament.Id ? selection.DuelId : null;
            LoadNextDuel(initialDuelId);
            _persistingSubscription = PageState.RegisterOnPersisting(PersistInitialDuel, InteractiveServer);
        }
    }

    private Task PersistInitialDuel()
    {
        if (_currentTournament is not null)
            PageState.PersistAsJson(InitialDuelStateKey, new InitialDuelSelection(_currentTournament.Id, _currentDuel?.Id));
        return Task.CompletedTask;
    }

    private void LoadNextDuel(Guid? initialDuelId = null, Guid? avoidDuelId = null)
    {
        if (GameService.GetCurrentTournament()?.Id != _currentTournament?.Id)
        {
            // Another tab can change the application-wide selection. Do not
            // present its games under this visit's old tournament context.
            _tournamentChanged = true;
            _ordinary.Reset();
            _game1 = _game2 = null;
            _voteNotice = string.Empty;
            return;
        }
        RefreshVoting();

        var pendingDuels = GameService.GetPendingDuels();
        var presentablePendingDuels = pendingDuels
            .Where(d => !ContainsArenaBannedTitle(d))
            .ToList();

        _presentablePendingCount = presentablePendingDuels.Count;
        _onlyArenaBanMatchesRemain = _arenaBannedGameIds.Count > 0 && pendingDuels.Count > 0 && presentablePendingDuels.Count == 0;

        _ordinary.Select(presentablePendingDuels, _arenaBannedGameIds, initialDuelId, avoidDuelId,
            _closestFirst ? _games.ToDictionary(game => game.Id, game => game.Points) : null);
        var gamesById = _games.ToDictionary(g => g.Id);
        _game1 = _currentDuel is { } duel1 ? gamesById.GetValueOrDefault(duel1.Game1Id) : null;
        _game2 = _currentDuel is { } duel2 ? gamesById.GetValueOrDefault(duel2.Game2Id) : null;
    }

    private void RefreshVoting()
    {
        _games = GameService.GetGames();
        _totalCount = GameService.TotalDuels();
        _completedCount = GameService.CompletedDuels();
        _pendingCount = _totalCount - _completedCount;
        _pendingPerGame = _games.ToDictionary(game => game.Id, _ => 0);
        var pending = GameService.GetPendingDuels();
        _presentablePendingCount = pending.Count(duel => !ContainsArenaBannedTitle(duel));
        _onlyArenaBanMatchesRemain = _arenaBannedGameIds.Count > 0 && pending.Count > 0 && _presentablePendingCount == 0;
        foreach (var duel in pending)
        {
            if (_pendingPerGame.ContainsKey(duel.Game1Id)) _pendingPerGame[duel.Game1Id]++;
            if (_pendingPerGame.ContainsKey(duel.Game2Id)) _pendingPerGame[duel.Game2Id]++;
        }
    }

    private Task CastVote(Guid presentation, Guid duelId, Guid winnerId)
    {
        // The callback retains both the round and participant shown to the user.
        if (!_sessionReady || FocusEntry is not null || _currentDuel is null || ContainsArenaBannedTitle(_currentDuel))
            return Task.CompletedTask;
        var outcome = _ordinary.Vote(GameService, _currentTournament!.Id, presentation, duelId, winnerId);
        if (outcome == OrdinaryDuelSession.VoteOutcome.Ignored) return Task.CompletedTask;
        if (outcome == OrdinaryDuelSession.VoteOutcome.Saved)
        {
            var winner = _games.FirstOrDefault(game => game.Id == winnerId);
            _voteNotice = winner is null ? "Vote saved." : $"Saved vote for {GetTitleDisplay(winner).Title}.";
        }
        else
        {
            _voteNotice = "This matchup changed. Available choices have been refreshed.";
        }
        LoadNextDuel();
        return Task.CompletedTask;
    }

    private void UndoLastVote(Guid presentation)
    {
        if (!_sessionReady || FocusEntry is not null) return;
        var lastDuelId = _ordinary.LastVote?.DuelId;
        var outcome = _ordinary.Undo(GameService, _currentTournament!.Id, presentation);
        if (outcome == OrdinaryDuelSession.UndoOutcome.Ignored) return;
        _voteNotice = outcome == OrdinaryDuelSession.UndoOutcome.Undone
            ? "Last vote undone."
            : "This vote has changed since you saved it and cannot be undone. The current result is preserved.";
        LoadNextDuel(outcome == OrdinaryDuelSession.UndoOutcome.Undone ? lastDuelId : _currentDuel?.Id);
    }

    private void SkipMatch(Guid presentation)
    {
        if (!_sessionReady || FocusEntry is not null || _currentDuel is null || presentation != _ordinary.Presentation) return;
        var skippedId = _currentDuel.Id;
        LoadNextDuel(avoidDuelId: skippedId);
        _voteNotice = _currentDuel?.Id == skippedId
            ? "This is the only available matchup. It remains pending."
            : "Skipped for now. No result saved.";
    }

    private async Task ToggleClosestFirst(ChangeEventArgs args)
    {
        // The matchup on screen stays; the new order applies from the next one.
        _closestFirst = args.Value is true;
        if (_shortcutModule is not null)
            await _shortcutModule.InvokeVoidAsync("saveSession", ClosestFirstKey, _closestFirst ? "1" : "0");
    }

    private bool ContainsArenaBannedTitle(Duel duel)
        => _arenaBannedGameIds.Contains(duel.Game1Id) || _arenaBannedGameIds.Contains(duel.Game2Id);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_currentTournament is null) return;
        if (_shortcutModule is null)
        {
            _shortcutModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/focusedVoting.js");
            await _shortcutModule.InvokeVoidAsync("connect", _root, new Dictionary<string, string>
            {
                ["1"] = "left", ["arrowleft"] = "left", ["2"] = "right", ["arrowright"] = "right", ["u"] = "undo", ["s"] = "skip"
            }, false);
            if (await _shortcutModule.InvokeAsync<string?>("readSession", ClosestFirstKey) == "0")
            {
                _closestFirst = false;
                StateHasChanged();
            }
        }
        if (!_restoreExclusions || _restoringExclusions) return;
        var tournamentId = _currentTournament.Id;
        _restoringExclusions = true;
        try
        {
            await _exclusions.RestoreAsync(JS, tournamentId, _games.Select(game => game.Id));
            if (_currentTournament?.Id == tournamentId)
            {
                _restoreExclusions = false;
                LoadNextDuel(_currentDuel?.Id);
            }
        }
        finally
        {
            _restoringExclusions = false;
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_shortcutModule is not null)
        {
            try
            {
                await _shortcutModule.InvokeVoidAsync("disconnect", _root);
                await _shortcutModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _persistingSubscription?.Dispose();
        await _exclusions.DisposeAsync();
    }
}

@page "/goty"
@rendermode InteractiveServer
@using BestestGame.Models
@using BestestGame.Services
@inject GameService GameService
@inject NavigationManager Navigation

<PageTitle>Game of the year | BestestGame</PageTitle>

<section class="surface goty-page stack" aria-labelledby="goty-heading">
    <header class="page-heading">
        <h1 id="goty-heading">Game of the year</h1>
    </header>

    @if (_tournament is null)
    {
        <div class="empty-state stack">
            <h2>No tournament selected</h2>
            <p>Select a tournament to explore its releases.</p>
            <div><a href="/tournaments" class="button button--primary"><span class="button__content">Choose a tournament</span></a></div>
        </div>
    }
    else if (_years.Count == 0)
    {
        <div class="empty-state stack">
            <h2>@(Year is { } emptyYear ? $"No releases in {emptyYear}" : "No release years assigned")</h2>
            <p>Add release years to games or included titles to populate the archive.</p>
            <p>@_unassigned @(_unassigned == 1 ? "title has" : "titles have") no release year.</p>
            @if (Year is not null)
            {
                <p><a href="/goty" class="text-link">View all years</a></p>
            }
            <div><a href="/import" class="button button--primary"><span class="button__content">Assign release years</span></a></div>
        </div>
    }
    else
    {
        <div class="field goty-year-select">
            <label for="archive-year" class="field-label">Release year</label>
            <select id="archive-year" class="form-control" value="@_selectedYear" @onchange="ChangeYear">
                @if (!_years.Contains(_selectedYear))
                {
                    <option value="@_selectedYear">@_selectedYear — no releases</option>
                }
                @foreach (var year in _years.AsEnumerable().Reverse())
                {
                    <option value="@year">@year · @_entries.Count(e => e.Year == year) releases</option>
                }
            </select>
        </div>

        @if (_nominees.Count == 0)
        {
            <div class="empty-state stack">
                <h2>No releases in @_selectedYear</h2>
                <p>No titles from this tournament have this release year. Choose another year above.</p>
            </div>
        }
        else
        {
            var lead = ReleaseRankings.GetLead(_nominees, _pending);
            var leaders = lead.Leaders;
            var hasPoints = _nominees[0].Points > 0;
            var votingInProgress = _tournament.Duels.Any(d => !d.IsCompleted);
            // A year is only called once no unfinished nominee can still take first place.
            var leaderLabel = !hasPoints ? "No points recorded" : !lead.Settled ? "Still open"
                : leaders.Count > 1 ? "Shared winners" : "Winner";
            <section class="goty-leaders stack" aria-labelledby="leaders-heading" @key="_selectedYear">
                <h2 id="leaders-heading">@_selectedYear · @leaderLabel</h2>
                @if (hasPoints)
                {
                    @foreach (var leader in leaders)
                    {
                        <div class="goty-leader" data-leader-game-id="@leader.GameId">
                            <h3>@leader.Title</h3>
                            @if (leader.GroupTitle is not null)
                            {
                                <p class="helper-text">Shared score from @leader.GroupTitle</p>
                            }
                            @if (!lead.Settled)
                            {
                                <p class="helper-text">@(leaders.Count > 1 ? "Shares the lead for now" : "Leads for now")@(_pending.GetValueOrDefault(leader.GameId) > 0 ? $" · {Open(leader.GameId, leader.Points)}" : "")</p>
                            }
                        </div>
                    }
                    <p class="goty-leader-score">@leaders[0].Points <span>points from the full tournament</span></p>
                    @if (lead.Contenders.Count > 0)
                    {
                        <ul class="goty-contenders">
                            @foreach (var contender in lead.Contenders.Take(ContendersShown))
                            {
                                <li @key="contender.GameId" data-contender-id="@contender.GameId">
                                    <span><strong>@contender.Title</strong> can still take first place: @contender.Points @(contender.Points == 1 ? "point" : "points"), @Open(contender.GameId, contender.Points).</span>
                                    <a href="@VotingRoutes.Focus(contender.GameId, null)" class="text-link">Finish its matchups</a>
                                </li>
                            }
                        </ul>
                        @if (lead.Contenders.Count > ContendersShown)
                        {
                            <p class="helper-text">@(lead.Contenders.Count - ContendersShown) more can still reach @leaders[0].Points points.</p>
                        }
                    }
                    else if (!lead.Settled)
                    {
                        <p class="helper-text">The leaders still have matchups that can part them.</p>
                    }
                }
                else
                {
                    <p class="text-secondary">Start voting to establish the leaders for this year. Points come from the full tournament.</p>
                }
                <p class="helper-text">@_nominees.Count @(_nominees.Count == 1 ? "release" : "releases") · @_nominees.Select(e => e.GameId).Distinct().Count() tournament @(_nominees.Select(e => e.GameId).Distinct().Count() == 1 ? "entry" : "entries")</p>
                @if (hasPoints && lead.Settled && votingInProgress)
                {
                    <p class="helper-text">Decided: no other release from @_selectedYear can still reach first place.@(_nominees.Any(e => _pending.GetValueOrDefault(e.GameId) > 0) ? " Other places can still change." : "")</p>
                }
                else if (votingInProgress || !hasPoints)
                {
                    <div class="goty-voting-context cluster">
                        @foreach (var leader in leaders.Where(e => hasPoints && _pending.GetValueOrDefault(e.GameId) > 0).DistinctBy(e => e.GameId))
                        {
                            <a @key="leader.GameId" href="@VotingRoutes.Focus(leader.GameId, null)" class="button"><span class="button__content">Finish @(leader.GroupTitle ?? leader.Title)</span></a>
                        }
                        <a href="/vote" class="button @(hasPoints ? "" : "button--primary")"><span class="button__content">Continue voting</span></a>
                    </div>
                }
                else
                {
                    <p class="helper-text">All tournament matchups are saved.</p>
                }
            </section>

            <table class="data-table goty-list">
                <caption>@_selectedYear nominees</caption>
                <colgroup><col class="goty-rank-column" /><col /><col class="goty-points-column" /></colgroup>
                <thead><tr><th scope="col">Rank</th><th scope="col">Title</th><th scope="col">Points</th></tr></thead>
                <tbody>
                    @foreach (var nominee in _nominees)
                    {
                        var rank = _nominees.FindIndex(e => e.SharesRankWith(nominee)) + 1;
                        <tr class="goty-nominee @(rank == 1 && hasPoints ? "goty-nominee--leader" : null)" data-game-id="@nominee.GameId">
                            <td class="goty-rank">@rank</td>
                            <th scope="row" class="goty-nominee-title">
                                <span>@nominee.Title</span>
                                @if (nominee.GroupTitle is not null)
                                {
                                    <p class="helper-text">Shared score from @nominee.GroupTitle</p>
                                }
                                @if (_nominees.Where(e => e.Points == nominee.Points).Select(e => e.GameId).Distinct().Count() > 1)
                                {
                                    <p class="helper-text">@nominee.HeadToHeadWins head-to-head @(nominee.HeadToHeadWins == 1 ? "win" : "wins") among tied entries</p>
                                }
                                @if (_pending.GetValueOrDefault(nominee.GameId) > 0)
                                {
                                    <p class="helper-text goty-open">@Open(nominee.GameId, nominee.Points)</p>
                                }
                            </th>
                            <td class="goty-points">@nominee.Points</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_unassigned > 0)
        {
            <p class="helper-text goty-unassigned">@_unassigned @(_unassigned == 1 ? "title has" : "titles have") no year and @(_unassigned == 1 ? "is" : "are") outside the archive. <a href="/import" class="text-link">Assign years</a></p>
        }

        <details class="goty-archive">
            <summary>Release-year archive · @_years.Count @(_years.Count == 1 ? "year" : "years")</summary>
            @* One wrapper: the disclosure animation unfolds a single child. *@
            <div>
            <div class="goty-explore">
                <button type="button" class="button" @onclick="SurpriseMe"><span class="button__content">Random year</span></button>
            </div>
            <div class="goty-archive-grid">
                @foreach (var year in _years.AsEnumerable().Reverse())
                {
                    var releases = _entries.Where(e => e.Year == year).ToList();
                    var bestPoints = releases[0].Points;
                    var yearLead = ReleaseRankings.GetLead(releases, _pending);
                    var leaders = yearLead.Leaders;
                    <a href="@YearUrl(year)" class="goty-portal button" aria-current="@(year == _selectedYear ? "page" : null)">
                        <span class="button__content">
                            <span class="goty-portal-year">@year</span>
                            <span>@(bestPoints > 0 ? leaders[0].Title : "No points recorded")</span>
                            @if (bestPoints > 0 && leaders.Count > 1)
                            {
                                <span class="helper-text">+ @(leaders.Count - 1) tied for first</span>
                            }
                            <span class="helper-text">@releases.Count @(releases.Count == 1 ? "release" : "releases")@(bestPoints > 0 && !yearLead.Settled ? " · still open" : "")</span>
                        </span>
                    </a>
                }
            </div>
            </div>
        </details>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "year")]
    public int? Year { get; set; }

    private Tournament? _tournament;
    private List<ReleaseRankings.Entry> _entries = [];
    private List<ReleaseRankings.Entry> _nominees = [];
    private List<int> _years = [];
    private int _selectedYear;
    private int _unassigned;
    private Dictionary<Guid, int> _pending = [];
    private const int ContendersShown = 4;

    // What an unfinished entry can still become: its matchups left and the points it can reach.
    private string Open(Guid gameId, int points)
    {
        var left = _pending.GetValueOrDefault(gameId);
        return $"{left} {(left == 1 ? "matchup" : "matchups")} left, can reach {points + left}";
    }

    protected override void OnParametersSet()
    {
        _tournament = GameService.GetCurrentTournament();
        _entries = ReleaseRankings.GetEntries(_tournament?.Games ?? [], _tournament?.Duels);
        _years = _entries.Select(e => e.Year).Distinct().Order().ToList();
        _selectedYear = Year ?? _years.LastOrDefault();
        _nominees = _entries.Where(e => e.Year == _selectedYear).ToList();
        _unassigned = ReleaseRankings.CountUnassigned(_tournament?.Games ?? []);
        _pending = _tournament is null ? [] : GameLibrary.PendingMatchups(_tournament);
    }

    private static string YearUrl(int year) => $"/goty?year={year}";
    private void Travel(int year) => Navigation.NavigateTo(YearUrl(year));
    private void ChangeYear(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var year))
            Travel(year);
    }
    private void SurpriseMe() => Travel(_years[Random.Shared.Next(_years.Count)]);
}

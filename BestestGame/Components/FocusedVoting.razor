@using System.Text.Json
@using BestestGame.Models
@using BestestGame.Services
@implements IAsyncDisposable
@inject GameService GameService
@inject IJSRuntime JS

@{ var presentation = _presentation; var current = _session.Current(_useGroups); }
<div class="focused-voting stack" @ref="_root" data-presentation="@presentation"
     data-shortcuts-enabled="@(ShortcutsEnabled && _ready && !_busy ? "true" : "false")">
    @if (_game is null)
    {
        <p class="status status--warning" role="status">This entry is no longer available in the selected tournament. Choose another entry or return to all matchups.</p>
    }
    else
    {
        var entryDisplay = EntryTitles.GetTitleDisplay(_game);
        // Without finished opponents the remaining groups widen to fill the bar.
        var barOrder = _showFinished ? _barOrder : _barOrder.Where(id => !_duels[id].IsCompleted).ToArray();
        <header class="focused-header">
            @if (current.Length == 0)
            {
                <div class="focused-entry">
                    <p class="eyebrow">Your entry</p>
                    <h2>@entryDisplay.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(entryDisplay.Subtitle))
                    {
                        <details class="included-context focused-entry-context">
                            <summary>@IncludedSummary(_game)</summary>
                            <p>@entryDisplay.Subtitle</p>
                        </details>
                    }
                </div>
            }
            <div class="focused-toggles">
                <label class="checkbox-field adaptive-toggle">
                    <input type="checkbox" checked="@_useGroups" disabled="@(!_ready || _busy)" @onchange="ToggleGroups" />
                    Adaptive groups
                </label>
                <label class="checkbox-field finished-toggle">
                    <input type="checkbox" checked="@_showFinished" disabled="@(!_ready)" @onchange="ToggleFinished" />
                    Show won and lost
                </label>
            </div>
        </header>

        <div class="focused-progress" aria-live="polite" aria-atomic="true">
            <p class="text-secondary">@_completedCount of @_totalCount matchups finished · @_session.RemainingCount available@(_blockedCount > 0 ? $" · {_blockedCount} arena-banned" : "")</p>
            <progress class="progress-bar" value="@_completedCount" max="@Math.Max(1, _totalCount)" aria-label="Completed matchups for this entry"></progress>
        </div>

        <div class="duel-stage" data-duel-stage data-duel-key="@string.Join(",", current)">
        <div data-duel-content>
        @if (current.Length == 0)
        {
            <div class="status @(_blockedCount > 0 ? "status--warning" : "status--success") stack" role="status">
                @if (_blockedCount > 0)
                {
                    <h3>Only arena-banned matchups remain</h3>
                    <p>Uncheck the banned titles on <a href="@RankingsUrl" class="text-link">Rankings</a> to finish this entry.</p>
                }
                else
                {
                    <h3>This entry is finished</h3>
                    <p>All of its matchups are saved. Choose another entry in Voting options or <a href="@RankingsUrl" class="text-link">view rankings</a>.</p>
                }
            </div>
        }
        else
        {
            // Buttons cannot contain disclosures, so included titles are shown as text.
            var opponents = current.Select(duelId => (DuelId: duelId, Game: Opponent(_duels[duelId]))).ToArray();
            var opponentTitles = opponents.Select(opponent => EntryTitles.GetTitleDisplay(opponent.Game).Title).ToArray();
            <div class="focused-matchup">
                <button type="button" class="tactile tactile--large tactile--secondary focused-choice"
                        disabled="@(!_ready || _busy)" data-action="win" aria-keyshortcuts="1 ArrowLeft"
                        aria-label="@($"{entryDisplay.Title} wins against {(current.Length == 1 ? opponentTitles[0] : $"all {current.Length} opponents in this group")}")"
                        aria-describedby="focused-batch-scope" @onclick="() => Vote(presentation, true)">
                    <span @key="presentation" class="tactile__face">
                        <span class="choice-label">Your entry</span>
                        <span class="choice-title">@entryDisplay.Title</span>
                        @if (!string.IsNullOrWhiteSpace(entryDisplay.Subtitle))
                        {
                            <span class="choice-context">@IncludedSummary(_game)</span>
                            <span class="choice-subtitle">@entryDisplay.Subtitle</span>
                        }
                        <span class="choice-help">1 or ←</span>
                    </span>
                </button>
                <span class="matchup-versus" aria-hidden="true">vs</span>
                <button type="button" class="tactile tactile--large tactile--secondary focused-choice"
                        disabled="@(!_ready || _busy)" data-action="lose" aria-keyshortcuts="2 ArrowRight"
                        aria-label="@(current.Length == 1 ? $"{opponentTitles[0]} wins against {entryDisplay.Title}" : $"All {current.Length} opponents in this group win against {entryDisplay.Title}: {string.Join(", ", opponentTitles)}")"
                        aria-describedby="focused-batch-scope" @onclick="() => Vote(presentation, false)">
                    <span @key="presentation" class="tactile__face">
                        <span class="choice-label">@(current.Length == 1 ? "Opponent" : $"All {current.Length} opponents in this group")</span>
                        <span class="opponent-list">
                            @foreach (var opponent in opponents)
                            {
                                var display = EntryTitles.GetTitleDisplay(opponent.Game);
                                <span @key="opponent.DuelId" class="opponent-item" data-duel-id="@opponent.DuelId" data-opponent-id="@opponent.Game.Id">
                                    <span class="opponent-title">@display.Title</span>
                                    @if (!string.IsNullOrWhiteSpace(display.Subtitle))
                                    {
                                        <span class="opponent-context">@display.Subtitle</span>
                                    }
                                </span>
                            }
                        </span>
                        <span class="choice-help">2 or →</span>
                    </span>
                </button>
            </div>
        }

        </div>
        </div>
        // Outside the duel stage: the bar stays in place while a vote slides the choices.
        <MatchupBar Opponents="@barOrder.Select(id => (id, StatusOf(_duels[id]))).ToArray()" Groups="@_session.Snapshot()" TitleOf="TitleOf"
                    Single="@(_useGroups || current.Length == 0 ? null : current[0])" JustSplit="_justSplit"
                    Disabled="@(!_ready || _busy)" OnSelect="@(id => Select(presentation, id))" />
        <div class="focused-controls" data-focused-controls>
            @if (current.Length > 0)
            {
                <p id="focused-batch-scope" class="action-context text-secondary">@(current.Length == 1 ? "1 opponent · 1 result per vote" : $"Entire group · {current.Length} opponents · {current.Length} results per vote")</p>
            }
            <div class="queue-actions">
                @if (current.Length > 1)
                {
                    <button type="button" class="button split-action" disabled="@(!_ready || _busy)" data-action="split" aria-keyshortcuts="M" @onclick="() => Split(presentation)">
                        <span @key="presentation" class="button__content">Split group</span>
                    </button>
                }
                <button type="button" class="button" disabled="@(!_ready || _busy || _history.Count == 0)" data-action="undo" aria-label="Undo last action" aria-keyshortcuts="U" @onclick="() => Undo(presentation)">
                    <span @key="presentation" class="button__content">Undo</span>
                </button>
                <button type="button" class="button" disabled="@(!_ready || _busy || current.Length == 0)" data-action="skip" aria-keyshortcuts="S" @onclick="() => Skip(presentation)">
                    <span @key="presentation" class="button__content">Skip for now</span>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_notice))
            {
                <p class="focused-notice text-secondary" role="status">@_notice</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid TournamentId { get; set; }
    [Parameter] public Guid GameId { get; set; }
    [Parameter] public IReadOnlySet<Guid> BannedGameIds { get; set; } = new HashSet<Guid>();
    [Parameter] public string RankingsUrl { get; set; } = "/rankings";
    [Parameter] public bool ShortcutsEnabled { get; set; } = true;
    [Parameter] public EventCallback OnResultsChanged { get; set; }

    private readonly AdaptiveDuelSession _session = new();
    private readonly Stack<VotingAction> _history = new();
    private Dictionary<Guid, Game> _games = [];
    private Dictionary<Guid, Duel> _duels = [];
    private Guid[] _barOrder = [];
    private Game? _game;
    private Guid _presentation = Guid.NewGuid();
    private bool _initialized;
    private bool _useGroups;
    private bool _busy;
    private bool _ready;
    private bool _saveSession;
    private bool _disposed;
    private int _completedCount;
    private int _totalCount;
    private int _blockedCount;
    private bool _justSplit;
    private bool _showFinished;
    private string _notice = "";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controlsModule;
    private string StorageKey => $"bestestgame:focused:{TournamentId}:{GameId}";
    // A viewing preference, so it is shared by every entry in this tab.
    private const string ShowFinishedKey = "bestestgame:focused:show-finished";
    private sealed record VotingAction(Guid[][] Groups, GameService.DuelResult[] Results);
    private sealed record SavedSession(Guid[][] Groups, bool UseGroups);

    protected override void OnParametersSet()
    {
        var before = _session.Current(_useGroups);
        Refresh();
        if (!_initialized)
        {
            _useGroups = _session.RemainingCount >= AdaptiveDuelSession.InitialGroupSize;
            _initialized = true;
        }
        if (!before.SequenceEqual(_session.Current(_useGroups)))
            AdvancePresentation();
    }

    private void Refresh()
    {
        var tournament = GameService.GetCurrentTournament();
        _game = tournament?.Id == TournamentId ? tournament.Games.FirstOrDefault(game => game.Id == GameId) : null;
        if (_game is null)
            return;

        _games = tournament!.Games.ToDictionary(game => game.Id);
        var ordered = OpponentBar.StandingOrder(tournament.Games, tournament.Duels, GameId);
        _duels = ordered.ToDictionary(duel => duel.Id);
        _barOrder = ordered.Select(duel => duel.Id).ToArray();
        _totalCount = _duels.Count;
        _completedCount = _duels.Values.Count(duel => duel.IsCompleted);
        _blockedCount = _duels.Values.Count(duel => StatusOf(duel) == OpponentBar.Status.Banned);
        _session.Synchronize(_barOrder.Where(id => StatusOf(_duels[id]) == OpponentBar.Status.Pending));
        _saveSession = true;
    }

    private Game Opponent(Duel duel) => _games[OpponentBar.OpponentId(duel, GameId)];
    private OpponentBar.Status StatusOf(Duel duel) => OpponentBar.StatusOf(duel, GameId, BannedGameIds);
    private string TitleOf(Guid duelId) => EntryTitles.GetTitleDisplay(Opponent(_duels[duelId])).Title;
    private static string IncludedSummary(Game game) => game.IncludedTitles is { Count: > 0 } titles
        ? $"{titles.Count} included {(titles.Count == 1 ? "title" : "titles")}" : "Included titles";

    private void AdvancePresentation()
    {
        _presentation = Guid.NewGuid();
        _saveSession = true;
    }

    private async Task Perform(Guid presentation, Func<Task> action)
    {
        // Events retain the presentation they came from. A double click or queued
        // shortcut from an old screen must not vote on the next group.
        if (!_ready || _busy || presentation != _presentation || _game is null)
            return;
        _busy = true;
        _justSplit = false;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
            AdvancePresentation();
        }
    }

    private Task Vote(Guid presentation, bool entryWins) => Perform(presentation, async () =>
    {
        var groups = _session.Snapshot();
        var votes = _session.Current(_useGroups).Select(id =>
            new GameService.DuelResult(id, entryWins ? GameId : Opponent(_duels[id]).Id)).ToArray();
        var recorded = GameService.RecordWinners(TournamentId, votes).ToArray();
        if (recorded.Length > 0)
        {
            _history.Push(new(groups, recorded));
            _notice = $"Saved {recorded.Length} {(recorded.Length == 1 ? "result" : "results")}.";
        }
        else
        {
            _notice = "These matchups have changed. The available choices have been refreshed.";
        }
        Refresh();
        await OnResultsChanged.InvokeAsync();
    });

    private Task Split(Guid presentation) => Perform(presentation, () =>
    {
        var before = _session.Snapshot();
        if (_useGroups && _session.SplitCurrent())
        {
            _history.Push(new(before, []));
            _justSplit = true;
            _notice = "Group split. No wins or losses recorded.";
        }
        return Task.CompletedTask;
    });

    private Task Select(Guid presentation, Guid duelId) => Perform(presentation, () =>
    {
        var before = _session.Snapshot();
        if (_session.BringToFront(duelId))
        {
            _history.Push(new(before, []));
            _notice = _useGroups ? "Switched to another group. No wins or losses recorded."
                : "Jumped to another opponent. No wins or losses recorded.";
        }
        return Task.CompletedTask;
    });

    private Task Skip(Guid presentation) => Perform(presentation, () =>
    {
        if (_session.RemainingCount > 0)
        {
            _history.Push(new(_session.Snapshot(), []));
            _session.SkipCurrent(_useGroups);
            _notice = "Skipped for now. These matchups remain in your queue.";
        }
        return Task.CompletedTask;
    });

    private Task Undo(Guid presentation) => Perform(presentation, async () =>
    {
        if (!_history.TryPeek(out var action))
            return;
        if (action.Results.Length > 0 && !GameService.UndoWinners(TournamentId, action.Results))
        {
            _notice = "This batch has changed since your vote and cannot be undone. Your other results are saved.";
            Refresh();
            return;
        }
        _history.Pop();
        _session.Restore(action.Groups);
        Refresh();
        _notice = action.Results.Length > 0 ? $"Undid {action.Results.Length} {(action.Results.Length == 1 ? "result" : "results")} from that vote." : "Undid the last queue change.";
        await OnResultsChanged.InvokeAsync();
    });

    private void ToggleGroups(ChangeEventArgs args)
    {
        if (!_ready || _busy)
            return;
        _useGroups = args.Value is true;
        _justSplit = false;
        _notice = _useGroups ? "Adaptive groups enabled." : "Rapid 1v1 voting enabled. Your entry stays on the left.";
        AdvancePresentation();
    }

    private async Task ToggleFinished(ChangeEventArgs args)
    {
        if (!_ready)
            return;
        _showFinished = args.Value is true;
        // Segments change place, which would replay the split on other elements.
        _justSplit = false;
        if (_module is not null)
            await _module.InvokeVoidAsync("saveSession", ShowFinishedKey, _showFinished ? "1" : "0");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/focusedVoting.js");
            if (_disposed)
                return;
            _showFinished = await _module.InvokeAsync<string?>("readSession", ShowFinishedKey) == "1";
            var saved = await _module.InvokeAsync<string?>("readSession", StorageKey);
            if (!string.IsNullOrEmpty(saved))
            {
                try
                {
                    var state = JsonSerializer.Deserialize<SavedSession>(saved);
                    if (state is not null && state.Groups is not null && state.Groups.All(group => group is not null))
                    {
                        _session.Restore(state.Groups.SelectMany(group => group.Chunk(AdaptiveDuelSession.InitialGroupSize)));
                        _useGroups = state.UseGroups;
                        Refresh();
                    }
                }
                catch (JsonException) { }
            }
            await _module.InvokeVoidAsync("connect", _root);
            _controlsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/focusedControls.js");
            if (_disposed)
                return;
            await _controlsModule.InvokeVoidAsync("connect", _root);
            _ready = true;
            AdvancePresentation();
            StateHasChanged();
        }
        if (_module is not null && _saveSession && !_disposed)
        {
            _saveSession = false;
            await _module.InvokeVoidAsync("saveSession", StorageKey,
                JsonSerializer.Serialize(new SavedSession(_session.Snapshot(), _useGroups)));
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                if (_controlsModule is not null)
                {
                    await _controlsModule.InvokeVoidAsync("disconnect", _root);
                    await _controlsModule.DisposeAsync();
                }
                await _module.InvokeVoidAsync("disconnect", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}

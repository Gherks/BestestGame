@inject NavigationManager Navigation

<div class="nav-menu">
    <a class="brand" href="" aria-label="BestestGame home">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.14 6.79Q3 6 3.46 6.65L8 13L11.69 4.24Q12 3.5 12.31 4.24L16 13L20.54 6.65Q21 6 20.86 6.79L19 17L5 17ZM5 19H19V21H5Z" /></svg></span>
        <span>BestestGame</span>
    </a>

    <TournamentSelector />

    <nav class="navigation desktop-navigation" aria-label="Main navigation">
        @MenuLinks
    </nav>
    <details class="mobile-menu" data-mobile-menu>
        <summary aria-label="@($"Navigation menu, current page: {CurrentPageLabel}")"><span>Menu</span> <span class="menu-current">@CurrentPageLabel</span></summary>
        <nav class="navigation mobile-navigation" aria-label="Main navigation">
            @MenuLinks
        </nav>
    </details>
</div>

@code {
    private RenderFragment MenuLinks => @<text>
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" aria-current="@CurrentPage("")">Home</NavLink>
        <NavLink class="nav-link" href="vote" aria-current="@CurrentPage("vote")">Voting</NavLink>
        <NavLink class="nav-link" href="rankings" aria-current="@CurrentPage("rankings")">Rankings</NavLink>
        <NavLink class="nav-link" href="import" aria-current="@CurrentPage("import")">Games</NavLink>
        <NavLink class="nav-link" href="goty" aria-current="@CurrentPage("goty")">Game of the year</NavLink>
        <NavLink class="nav-link" href="tournaments" aria-current="@CurrentPage("tournaments")">Tournaments</NavLink>
    </text>;

    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    private string CurrentPageLabel => CurrentPath.ToLowerInvariant() switch
    {
        "" => "Home",
        "vote" => "Voting",
        "rankings" => "Rankings",
        "import" => "Games",
        "goty" => "Game of the year",
        "tournaments" => "Tournaments",
        _ => "Navigation"
    };

    private string? CurrentPage(string path)
        => string.Equals(CurrentPath, path, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}

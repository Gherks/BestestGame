@inject NavigationManager Navigation

<div class="nav-menu">
    <a class="brand" href="" aria-label="BestestGame home">
        <span class="brand-mark" aria-hidden="true">B</span>
        <span>BestestGame</span>
    </a>

    <nav class="navigation" aria-label="Main navigation">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" aria-current="@CurrentPage("")">Home</NavLink>
        <NavLink class="nav-link" href="tournaments" aria-current="@CurrentPage("tournaments")">Tournaments</NavLink>
        <NavLink class="nav-link" href="vote" aria-current="@CurrentPage("vote")">Voting</NavLink>
        <NavLink class="nav-link" href="import" aria-current="@CurrentPage("import")">Import games</NavLink>
        <NavLink class="nav-link" href="goty" aria-current="@CurrentPage("goty")">Game of the year</NavLink>
    </nav>
</div>

@code {
    private string? CurrentPage(string path)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    }
}

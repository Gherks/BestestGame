@inherits LayoutComponentBase

<a class="skip-link" href="#main-content" data-enhance-nav="false">Skip to content</a>

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main id="main-content" class="app-main" tabindex="-1">
        <article class="app-content">
            @Body
        </article>
        <footer class="app-footer">BestestGame</footer>
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    <div class="error-content">
        <p>An unexpected error occurred. Reload the page to continue.</p>
        <div class="error-actions">
            <a href="" class="reload tactile tactile--compact tactile--primary">
                <span class="tactile__face">Reload page</span>
            </a>
            <button type="button" class="dismiss tactile tactile--compact tactile--secondary" aria-label="Dismiss error notification">
                <span class="tactile__face">Dismiss</span>
            </button>
        </div>
    </div>
</div>

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-debug",
      "dependsOn": ["build-development", "refresh-development-data"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "build-development",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/BestestGame/BestestGame.csproj", "--configuration", "Debug"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "refresh-development-data",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/refresh-dev-data.py"],
      "problemMatcher": []
    }
  ]
}
